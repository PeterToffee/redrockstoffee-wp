{
    "name": "wpdesk\/wp-wpdesk-tracker",
    "license": "MIT",
    "authors": [
        {
            "name": "WP Desk",
            "homepage": "https:\/\/wpdesk.net"
        },
        {
            "name": "Krzysiek",
            "email": "krzysiek@wpdesk.pl"
        }
    ],
    "require": {
        "php": ">=7.4 || ^8",
        "wpdesk\/wp-builder": "^2.0",
        "wpdesk\/wp-notice": "^3.1",
        "wpdesk\/wp-view": "^2",
        "psr\/log": "^1 || ^2"
    },
    "require-dev": {
        "phpunit\/phpunit": "^7 || ^8 || ^9",
        "johnpbloch\/wordpress-core": "^6.9",
        "johnpbloch\/wordpress-core-installer": "^2",
        "wpdesk\/phpstan-rules": "^1",
        "wpdesk\/wp-code-sniffer": "^1",
        "wp-phpunit\/wp-phpunit": "^6.9",
        "yoast\/phpunit-polyfills": "^4"
    },
    "autoload": {
        "classmap": [
            "src"
        ],
        "exclude-from-classmap": [
            "\/src\/Tracker\/"
        ],
        "psr-4": {
            "FSVendor\\WPDesk\\Tracker\\": "src\/Tracker\/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests\/"
        ]
    },
    "extra": {
        "wordpress-install-dir": "vendor\/wordpress",
        "text-domain": "wpdesk-tracker",
        "translations-folder": "lang",
        "po-files": {
            "pl_PL": "pl_PL.po",
            "es_ES": "es_ES.po",
            "en_AU": "en_AU.po",
            "en_CA": "en_CA.po",
            "en_GB": "en_GB.po",
            "de_DE": "de_DE.po"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit-unit.xml --colors=never",
        "test:integration": "phpunit --configuration phpunit-integration.xml --colors=never",
        "phpcs": "phpcs --warning-severity=0",
        "phpcbf": "phpcbf",
        "phpstan": "phpstan --memory-limit=2G",
        "docs": "apigen generate"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect\/phpcodesniffer-composer-installer": true,
            "johnpbloch\/wordpress-core-installer": true,
            "phpstan\/extension-installer": true
        }
    }
}